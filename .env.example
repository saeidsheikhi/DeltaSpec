# DeltaSpec / effectgate runtime configuration (copy to .env and edit)
EFFECTGATE_PROVIDER=ollama

# Your Ollama endpoint (never assumed to be localhost). Example: http://localhost:11434
OLLAMA_BASE_URL=http://<your-ollama-host>:11434
OLLAMA_TIMEOUT_S=900
OLLAMA_DEFAULT_MODEL=qwen3.5:latest
# Disable "thinking" for models that support it (used for the reported qwen3.5 runs)
OLLAMA_THINK=false

# Optional cloud provider. Not used by any reported result; keep disabled.
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Reproducibility
EFFECTGATE_RUNS_DIR=runs
EFFECTGATE_RESULTS_DIR=results
EFFECTGATE_SEED=42

# Release mode: a malformed contract/evaluation fails closed
EFFECTGATE_FAIL_CLOSED=true

# AppWorld data must live OUTSIDE this repository (its downloader deletes <root>/data).
APPWORLD_ROOT=/absolute/path/outside/this/repo/appworld-root
